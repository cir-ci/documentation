---
// <ReviewCompare />: the landing page's real before / after / diff (see ReviewCompare.tsx).
import { getImage } from 'astro:assets'
import ReviewCompare from './ReviewCompare'
import before from '../assets/screens/hero-before.jpg'
import after from '../assets/screens/hero-after.jpg'
import diff from '../assets/screens/hero-diff.jpg'

const [b, a, d] = await Promise.all([before, after, diff].map((src) => getImage({ src, format: 'webp', quality: 92 })))
---

<ReviewCompare client:load before={b.src} after={a.src} diff={d.src} width={before.width} height={before.height} />

<style is:global>
  /* The captures are 1520px wide, 2x of a 760px crop: the card stops near 760 CSS px so they stay sharp on retina. */
  .review-compare {
    max-width: 800px;
    margin-inline: auto;
    border: 1px solid var(--circi-line-strong);
    border-radius: var(--circi-radius-command);
    background: var(--circi-surface-chrome);
    overflow: clip;
  }
  .rc-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
    padding: 0.5rem 0.75rem;
    border-block-end: 1px solid var(--circi-line-subtle);
    font-size: 0.8125rem;
  }
  .rc-state {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--circi-state-review-text);
    font-weight: 500;
  }
  .rc-state svg {
    color: var(--circi-state-review);
  }
  .rc-head > * {
    min-width: 0;
  }
  .rc-name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .rc-meta {
    font-family: var(--circi-font-mono);
    font-size: 0.75rem;
    color: var(--circi-text-secondary);
    overflow-wrap: anywhere;
  }
  .rc-modes {
    display: inline-flex;
    margin-inline-start: auto;
    padding: 2px;
    border: 1px solid var(--circi-line-subtle);
    border-radius: var(--circi-radius-control);
    background: var(--circi-surface-panel);
  }
  .rc-modes button {
    height: 1.625rem;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: var(--circi-radius-inline);
    background: transparent;
    color: var(--circi-text-secondary);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
  }
  .rc-modes button:hover {
    color: var(--circi-text-primary);
  }
  .rc-modes button[aria-pressed='true'] {
    background: var(--circi-surface-overlay);
    box-shadow: 0 0 0 1px var(--circi-line-subtle);
    color: var(--circi-text-primary);
  }
  .rc-stage {
    position: relative;
    margin: 0.75rem;
    border-radius: var(--circi-radius-control);
    overflow: clip;
    background: var(--circi-surface-panel);
    touch-action: pan-y;
  }
  .rc-stage img {
    display: block;
    margin: 0; /* Starlight spaces a sibling in prose by 1rem */
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rc-stage .rc-before {
    position: absolute;
    inset: 0;
  }
  .rc-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-inline-start: -1px;
    background: var(--circi-accent-main);
    pointer-events: none;
  }
  .rc-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.75rem;
    height: 1.75rem;
    translate: -50% -50%;
    border: 2px solid var(--circi-accent-main);
    border-radius: 999px;
    background: var(--circi-surface-panel);
  }
  .rc-grip::before,
  .rc-grip::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.3rem;
    height: 0.3rem;
    border: solid var(--circi-accent-text);
    border-width: 0 0 2px 2px;
  }
  .rc-grip::before {
    left: 0.35rem;
    rotate: 45deg;
    translate: 0 -50%;
  }
  .rc-grip::after {
    right: 0.35rem;
    rotate: -135deg;
    translate: 0 -50%;
  }
  .rc-stage input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .rc-stage:has(input:focus-visible) {
    outline: 2px solid var(--circi-accent-text);
    outline-offset: 2px;
  }
  /* The diff image is red on white; on the dark scheme it is inverted to the app's stage, hue kept. */
  .rc-stage .rc-diff {
    filter: invert(1) hue-rotate(180deg) saturate(0.85);
  }
  :root[data-theme='light'] .rc-stage .rc-diff {
    filter: saturate(0.8);
  }
  .rc-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .rc-swatch {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--circi-line-strong);
    border-radius: 2px;
    background: var(--circi-surface-panel);
  }
  .rc-swatch--changed {
    border-color: transparent;
    background: var(--circi-state-failed);
  }
  .rc-foot {
    display: flex;
    justify-content: space-between;
    padding: 0 0.875rem 0.625rem;
    font-size: 0.75rem;
    color: var(--circi-text-secondary);
  }
</style>
