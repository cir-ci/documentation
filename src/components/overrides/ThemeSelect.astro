---
// System / Light / Dark, drawn like the app's ColorSchemeControl (a segmented control).
// Starlight's own storage key and `data-theme` attribute are kept, so ThemeProvider still
// paints the right scheme before first render.
---

<circi-theme-select>
  <div role="group" aria-label="Theme" class="segments">
    <button type="button" data-value="auto" aria-label="System theme" title="System">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2.5" width="12" height="8.5" rx="1.5" /><path d="M5.5 13.5h5M8 11v2.5" /></svg>
    </button>
    <button type="button" data-value="light" aria-label="Light theme" title="Light">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.75" /><path d="M8 1.5v1.4M8 13.1v1.4M1.5 8h1.4M13.1 8h1.4M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" /></svg>
    </button>
    <button type="button" data-value="dark" aria-label="Dark theme" title="Dark">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8z" /></svg>
    </button>
  </div>
</circi-theme-select>

<script>
  type Theme = 'auto' | 'light' | 'dark'
  const parse = (v: unknown): Theme => (v === 'light' || v === 'dark' ? v : 'auto')
  const load = (): Theme => parse(typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme'))
  const apply = (t: Theme) => {
    document.documentElement.dataset.themePref = t
    document.documentElement.dataset.theme =
      t === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : t
  }

  class CirciThemeSelect extends HTMLElement {
    constructor() {
      super()
      const buttons = this.querySelectorAll<HTMLButtonElement>('button')
      const sync = () => {
        const t = load()
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === t)))
      }
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const t = parse(b.dataset.value)
          try {
            localStorage.setItem('starlight-theme', t === 'auto' ? '' : t)
          } catch {}
          apply(t)
          document.dispatchEvent(new CustomEvent('circi-theme'))
        }),
      )
      document.addEventListener('circi-theme', sync)
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => load() === 'auto' && apply('auto'))
      sync()
    }
  }
  if (!customElements.get('circi-theme-select')) customElements.define('circi-theme-select', CirciThemeSelect)
</script>

<style>
  .segments {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--circi-line-subtle);
    border-radius: var(--circi-radius-control);
    background: var(--circi-surface-panel);
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.625rem;
    padding: 0;
    border: 0;
    border-radius: var(--circi-radius-inline);
    background: transparent;
    color: var(--circi-text-secondary);
    cursor: pointer;
  }
  button:hover {
    color: var(--circi-text-primary);
  }
  /* The selected button comes from the root's data-theme-pref, set before first paint by the head script,
     so it is right on every load and after every navigation. aria-pressed mirrors it for assistive tech. */
  :global(html[data-theme-pref='auto']) button[data-value='auto'],
  :global(html[data-theme-pref='light']) button[data-value='light'],
  :global(html[data-theme-pref='dark']) button[data-value='dark'] {
    background: var(--circi-surface-overlay);
    box-shadow: 0 0 0 1px var(--circi-line-subtle);
    color: var(--circi-text-primary);
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
