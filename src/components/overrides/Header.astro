---
// Starlight's header (logo, search, theme control), kept between pages: the client router moves the
// same DOM into the next page instead of drawing it again, so nothing in it can flash or lose state.
import Default from '@astrojs/starlight/components/Header.astro'
---

<div class="persist" transition:persist="circi-header">
  <Default {...Astro.props}><slot /></Default>
</div>

<script>
  // The header is kept between pages, search included. The incoming page brings its own
  // <site-search>, which starts up when the router adopts it, even though the kept header replaces
  // it: its setup then adds a second Pagefind search box to the kept #starlight__search (one more on
  // every page change). Dropping the incoming one before the swap leaves the kept search alone.
  document.addEventListener('astro:before-swap', (event) => {
    if (!document.querySelector('site-search')) return
    for (const incoming of event.newDocument.querySelectorAll('site-search')) incoming.remove()
  })
</script>

<style>
  .persist {
    display: contents;
  }
</style>
