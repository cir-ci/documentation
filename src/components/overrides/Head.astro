---
// Starlight's head, plus what makes navigation swap the page instead of loading a new one:
// Astro's client router, the theme applied before first paint and after every swap, and the
// main fonts preloaded. See DESIGN.md ("Navigation").
import Default from '@astrojs/starlight/components/Head.astro'
import { ClientRouter } from 'astro:transitions'
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import mono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url'
---

<Default {...Astro.props}><slot /></Default>
<link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
{/* Blocking and inline on purpose. `data-theme` is the scheme Starlight's CSS reads; `data-theme-pref` is
   the reader's choice (auto, light, dark) so the theme control can draw its selected button in CSS,
   before any script has run. A swap replaces the root's attributes with the new page's defaults, so
   both are set again right after it, before the new page paints. */}
<script is:inline>
  (() => {
    const apply = () => {
      let stored = ''
      try {
        stored = localStorage.getItem('starlight-theme') || ''
      } catch {}
      const pref = stored === 'light' || stored === 'dark' ? stored : 'auto'
      const root = document.documentElement
      root.dataset.theme = pref === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : pref
      root.dataset.themePref = pref
    }
    apply()
    document.addEventListener('astro:after-swap', apply)
  })()
</script>
<ClientRouter />
