---
// The header's brand: the logo mark (rounded, as in the app's sidebar) and the name.
import logo from '../../assets/logo.svg'
const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="brand">
  <img src={logo.src} alt="" width="26" height="26" />
  <span class="name" translate="no">CirCI</span>
  <span class="docs">Docs</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--circi-text-primary);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--circi-radius-control);
  }
  img {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: var(--circi-radius-control);
  }
  .name {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .docs {
    padding-inline-start: 0.625rem;
    border-inline-start: 1px solid var(--circi-line-strong);
    font-size: var(--sl-text-sm);
    color: var(--circi-text-secondary);
  }
</style>
