---
// A callout for a passage about a setting that is edited in Instance settings. Pass an explicit
// `title`; don't use it for settings that are read-only there (an environment variable only).
interface Props {
  /** The callout's title: say what the passage tells the reader, in sentence case. */
  title?: string
}
const { title = 'Set in Instance settings' } = Astro.props
---

<aside class="instance-setting" aria-label={title}>
  <p class="instance-setting__title">{title}</p>
  <div class="instance-setting__body">
    <slot>
      Set in <strong>Instance settings</strong>, or by the environment variable as the initial value.
    </slot>
  </div>
</aside>

<style>
  .instance-setting {
    margin-block: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--circi-line-strong);
    border-radius: var(--circi-radius-popup);
    background: var(--circi-accent-subtle);
  }
  .instance-setting__title {
    margin: 0 0 0.25rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }
  .instance-setting__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
